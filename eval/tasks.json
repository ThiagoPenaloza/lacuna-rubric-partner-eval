{
  "schema_version": 2,
  "language": "en",
  "provenance": "Synthetic fixtures based on the six cases in EVAL_SPEC_V2; answer keys, not model results. Lexical heuristics pending human adjudication. English translation of the original Portuguese task set, preserving the same requirements and grading semantics.",
  "tasks": [
    {
      "id": "incident_01",
      "input": {
        "goal": "evaluate an incident report",
        "context": "must record the start time, the impact on users, and the recovery action",
        "rubric_draft": "C1: The report describes the probable cause."
      },
      "expected_status": "review_ready",
      "expected_findings": [
        {
          "id": "start_time",
          "kind": "omission",
          "anchors": [
            "start time",
            "starting time",
            "when the incident started",
            "when the incident began"
          ],
          "suggestion_anchors": [
            "start time",
            "starting time",
            "when the incident started",
            "when the incident began"
          ],
          "suggestion_patterns": [
            "(?:record|report|includ|requir|identif|indicat|specif|stat|contain|list).{0,100}(?:start(?:ing)? time|when the incident (?:started|began))"
          ]
        },
        {
          "id": "user_impact",
          "kind": "omission",
          "anchors": [
            "impact",
            "scope"
          ],
          "suggestion_anchors": [
            "impact",
            "scope"
          ],
          "suggestion_patterns": [
            "(?:describ|record|report|includ|requir|identif|indicat|specif|stat|contain).{0,100}(?:observable impact|impact on (?:the )?users|user impact|affected users|scope of (?:the )?(?:incident|impact))"
          ]
        },
        {
          "id": "recovery",
          "kind": "omission",
          "anchors": [
            "recovery",
            "restoration"
          ],
          "suggestion_anchors": [
            "recovery",
            "restoration"
          ],
          "suggestion_patterns": [
            "(?:describ|record|report|includ|requir|identif|indicat|specif|stat|contain).{0,100}(?:(?:recovery|restoration) (?:action|step|outcome|result)|(?:action|outcome|result).{0,30}(?:recovery|restoration))"
          ]
        }
      ],
      "rejection_patterns": [
        "\\bthere (?:is|are) no (?:gaps?|omissions?|missing requirements?)\\b",
        "(?:\\bno gaps?\\b|\\bno omissions?\\b|all (?:the )?requirements (?:are )?(?:already )?(?:covered|addressed))",
        "(?:\\bnothing (?:is )?(?:missing|omitted)\\b|\\bnot missing\\b)",
        "(?:gap|omission).{0,20}(?:does not exist|doesn't exist|nonexistent)"
      ],
      "annotation_note": "Correction requested after review: require start time, impact, and recovery, all explicit in the context, even though the initial V2 answer key listed only the last two."
    },
    {
